      stage.addEventListener('wheel',e=>{if(!e.ctrlKey&&!e.metaKey)return;e.preventDefault();zoom(scale*Math.exp(-e.deltaY*.008),e.clientX,e.clientY);},{passive:false});
      stage.addEventListener('dblclick',e=>{e.preventDefault();zoom(scale>1.001?1:2,e.clientX,e.clientY);});
      stage.addEventListener('pointerdown',e=>{if(e.pointerType!=='mouse'||e.button!==0||scale<=1.001)return;mouse={id:e.pointerId,x:e.clientX,y:e.clientY};stage.setPointerCapture(e.pointerId);});
      stage.addEventListener('pointermove',e=>{if(!mouse||mouse.id!==e.pointerId)return;pan(e.clientX-mouse.x,e.clientY-mouse.y);mouse.x=e.clientX;mouse.y=e.clientY;});
      for(const event of ['pointerup','pointercancel','lostpointercapture'])stage.addEventListener(event,()=>{mouse=null;});
      stage.addEventListener('keydown',e=>{if(['+','=','-','0','ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.key))e.preventDefault();switch(e.key){case '+':case '=':zoom(scale*1.5);break;case '-':zoom(scale/1.5);break;case '0':zoom(1);break;case 'ArrowLeft':pan(30,0);break;case 'ArrowRight':pan(-30,0);break;case 'ArrowUp':pan(0,30);break;case 'ArrowDown':pan(0,-30);break;}});
      function clearReadout(){if(!advanced)return;stage.querySelector('.candle-readout').hidden=true;stage.querySelector('.candle-crosshair').hidden=true;}
      function showReadout(clientX){if(!advanced)return;const b=plot.getBoundingClientRect(),start=Number(stage.dataset.start)||0,count=Number(stage.dataset.count)||48,i=clamp(Math.floor(start+clamp((clientX-b.left)/b.width,0,1)*count),0,47),d=candleSeries(coin,selectedPeriod)[i],output=stage.querySelector('.candle-readout'),cross=stage.querySelector('.candle-crosshair');output.dataset.candle=String(i);output.innerHTML=`<strong>${coin.symbol} · Свеча ${i+1}</strong><div>${[['Откр.',d.open],['Макс.',d.high],['Мин.',d.low],['Закр.',d.close]].map(([label,value])=>`<span>${label}<b>${chartPrice(value,coin)}</b></span>`).join('')}</div><small>Объём: ${number(d.volume,d.volume<10?2:0)} ${coin.symbol}</small>`;output.hidden=false;cross.style.left=`${clamp((i+.5-start)/count,0,1)*b.width}px`;cross.hidden=false;}
      if(advanced){stage.addEventListener('pointermove',e=>{if(e.pointerType==='mouse')showReadout(e.clientX);});stage.addEventListener('pointerleave',clearReadout);stage.addEventListener('click',e=>showReadout(e.clientX));stage.addEventListener('touchstart',e=>{if(e.touches.length>1)clearReadout();},{passive:true});}
      paint();
    }
    function showCard(id){const c=state.cards.find(c=>c.id===id);if(!c)return;openModal(`Карта ${c.bank}`,`<div class="modal-card"><div class="bank-card ${c.style} ${c.frozen?'frozen':''}">${cardHtml(c)}</div></div><div class="detail-stats"><span>Статус</span>${c.frozen?'Заморожена':'Активна'}</div><div class="detail-stats"><span>Валюта счёта</span>Российский рубль</div><div class="detail-stats"><span>Владелец</span>${esc(state.name)}</div><p class="modal-text">${c.frozen?'Разморозьте карту, чтобы выполнять операции.':'Заморозка временно отключит покупки и переводы по этой карте.'}</p><button class="primary full secondary" id="freeze-card">${c.frozen?'Разморозить карту':'Заморозить карту'}</button>`);$('#freeze-card').onclick=()=>{c.frozen=!c.frozen;save();render();showCard(id);toast(c.frozen?'Карта заморожена':'Карта снова активна');};}
    function addCardModal(){if(state.cards.length>=8){toast('В демоверсии можно добавить до 8 карт.');return;}openModal('Добавить карту',`<p class="modal-subtitle">Создайте ещё одну виртуальную карту</p><form id="add-form"><label class="field">Банк<select id="bank-name"><option>Сбер</option><option>Альфа-Банк</option><option>ВТБ</option></select></label><label class="field">Стиль карты<select id="card-style"><option value="sber">Сбер · зелёная</option><option value="alfa">Альфа-Банк · красная</option><option value="vtb">ВТБ · синяя</option></select></label><div class="form-note">Новая карта появится с нулевым балансом. Пополните её виртуальными деньгами или переведите средства с другой карты.</div><button class="primary full" type="submit">Добавить карту</button></form>`);$('#add-form').onsubmit=e=>{e.preventDefault();state.cards.push({id:'card-'+Date.now(),bank:$('#bank-name').value,type:'Дебетовая',style:$('#card-style').value,last:String(Math.floor(1000+Math.random()*9000)),balance:0,frozen:false});commit('Новая демо-карта добавлена');};}
    function settingsModal(){openModal('Настройки',`<div class="settings-menu"><button type="button" class="settings-row" data-settings-placeholder="profile"><span class="settings-item-icon">${icon('person')}</span><span>Профиль</span>${icon('chevron')}</button><section class="settings-chart"><div class="settings-chart-label"><span class="settings-item-icon">${icon('chart')}</span><h3>Режим графика</h3></div><div class="settings-choices" role="group" aria-label="Режим графика"><button type="button" data-chart-mode="beginner" class="${state.chartMode==='beginner'?'active':''}" aria-pressed="${state.chartMode==='beginner'}">Новичок</button><button type="button" data-chart-mode="advanced" class="${state.chartMode==='advanced'?'active':''}" aria-pressed="${state.chartMode==='advanced'}">Продвинутый</button></div><p class="chart-mode-description">${state.chartMode==='advanced'?'Свечи, объёмы и средняя цена SMA 7. Нажмите на график, чтобы увидеть данные свечи.':'Простая линия: зелёные участки — рост, красные — снижение.'}</p></section><button type="button" class="settings-row" data-settings-placeholder="support"><span class="settings-item-icon">${icon('help')}</span><span>Поддержка</span>${icon('chevron')}</button></div>`);$('#modal-body [data-chart-mode="'+state.chartMode+'"]').focus({preventScroll:true});}
    function setChartMode(mode){if(!['beginner','advanced'].includes(mode)||state.chartMode===mode)return;state.chartMode=mode;save();render();if($('#modal').open&&$('#modal-title').textContent==='Настройки')settingsModal();}
    function profileModal(){openModal('Ваш профиль',`<form id="profile-form" novalidate><label class="field">Как к вам обращаться<input id="profile-name" value="${esc(state.name)}" maxlength="30" required autocomplete="given-name"></label><div class="form-error" id="form-error" role="alert"></div><button class="primary full" type="submit">Сохранить</button></form><div class="profile-footer"><p class="small muted">Начать знакомство заново с исходными балансами и картами.</p><button class="text-btn" id="reset-demo">Сбросить демоданные</button></div>`);$('#profile-form').onsubmit=e=>{e.preventDefault();const name=$('#profile-name').value.trim();if(name.length<2)return error('Введите имя: от 2 до 30 символов.');state.name=name;commit('Профиль обновлён');};$('#reset-demo').onclick=()=>{openModal('Сбросить демоданные?',`<p class="modal-text">Все добавленные карты, сделки и переводы будут удалены. Балансы и портфель вернутся к исходным значениям.</p><div class="trade-buttons"><button class="primary secondary" id="cancel-reset">Отмена</button><button class="primary" id="confirm-reset">Сбросить</button></div>`);$('#cancel-reset').onclick=profileModal;$('#confirm-reset').onclick=()=>{state=initialState();historyExpanded=false;favoritesOnly=false;sortDirection=0;save();closeModal();navigate('accounts');toast('Демоданные восстановлены');};};}
    function helpModal(){openModal('С Patrn всё проще',`<div class="notice"><strong>01 / Соберите счета</strong><p>На экране «Счета» видны все карты и их общий баланс. Переводите деньги себе или пополняйте демо-карты.</p></div><div class="notice"><strong>02 / Выберите монету</strong><p>В Crypto найдите монету, откройте её график и описание. Звёздочка добавляет монету в избранное.</p></div><div class="notice"><strong>03 / Попробуйте сделку</strong><p>Нажмите «Купить», выберите карту и укажите сумму в рублях. Монеты появятся в портфеле, а сделка — в истории. Продать их можно на том же экране.</p></div><p class="modal-text">Patrn — интерактивный прототип. Все банковские карты, операции, цены и графики демонстрационные. Изменения сохраняются только в этом браузере. Демо-курс: 1 $ = ${number(USD_RATE)} ₽.</p><button class="primary full" id="help-done">Понятно, попробую</button>`);$('#help-done').onclick=closeModal;}
    const navScrollState={lastY:0,direction:0,distance:0,ticking:false};
    function resetMobileNav(){const nav=$('.mobile-nav');nav.classList.remove('nav-hidden');navScrollState.lastY=Math.max(0,window.scrollY);navScrollState.direction=0;navScrollState.distance=0;}
    function updateMobileNav(){
      navScrollState.ticking=false;
      const max=Math.max(0,document.documentElement.scrollHeight-window.innerHeight),y=Math.max(0,Math.min(window.scrollY,max)),delta=y-navScrollState.lastY;
      navScrollState.lastY=y;
      if($('#modal').open)return;
      if(y<=12){resetMobileNav();return;}
      if(Math.abs(delta)<1)return;
      const direction=delta>0?1:-1;
      if(direction!==navScrollState.direction){navScrollState.direction=direction;navScrollState.distance=0;}
      navScrollState.distance+=Math.abs(delta);
      if(direction>0&&y>48&&navScrollState.distance>=24)$('.mobile-nav').classList.add('nav-hidden');
      if(direction<0&&navScrollState.distance>=10)$('.mobile-nav').classList.remove('nav-hidden');
    }
    window.addEventListener('scroll',()=>{if(!navScrollState.ticking){navScrollState.ticking=true;requestAnimationFrame(updateMobileNav);}},{passive:true});
    window.addEventListener('resize',resetMobileNav);
    $('.mobile-nav').addEventListener('focusin',resetMobileNav);
    let coinSwipe=null;
    function beginCoinSwipe(target,id,cx,cy){
      if(currentPage!=='detail'||$('#modal').open||!target.closest('.main')||target.closest('button,input,select,textarea,a,[contenteditable]'))return null;
      const chart=target.closest('.inline-chart');if(chart&&Number(chart.dataset.zoom)>1.001)return null;
      return {id,x:cx,y:cy,lastX:cx,lastY:cy,time:performance.now()};
    }
    function moveCoinSwipe(e,cx,cy){if(!coinSwipe)return;coinSwipe.lastX=cx;coinSwipe.lastY=cy;const dx=cx-coinSwipe.x,dy=cy-coinSwipe.y;if(dx>12&&dx>Math.abs(dy)*1.6&&e.cancelable)e.preventDefault();}
    function finishCoinSwipe(){const swipe=coinSwipe;coinSwipe=null;if(!swipe||currentPage!=='detail'||$('#modal').open)return;const dx=swipe.lastX-swipe.x,dy=swipe.lastY-swipe.y;if(dx>=Math.max(64,Math.min(100,innerWidth*.18))&&dx>Math.abs(dy)*1.6&&performance.now()-swipe.time<1200)navigate('crypto');}
    document.addEventListener('touchstart',e=>{if(e.touches.length!==1){coinSwipe=null;return;}const t=e.touches[0];coinSwipe=beginCoinSwipe(e.target,t.identifier,t.clientX,t.clientY);},{passive:true,capture:true});
    document.addEventListener('touchmove',e=>{if(!coinSwipe)return;if(e.touches.length!==1){coinSwipe=null;return;}const t=[...e.touches].find(t=>t.identifier===coinSwipe.id);if(t)moveCoinSwipe(e,t.clientX,t.clientY);},{passive:false});
    document.addEventListener('touchend',e=>{if(e.touches.length){coinSwipe=null;return;}if(coinSwipe){const t=[...e.changedTouches].find(t=>t.identifier===coinSwipe.id);if(t){coinSwipe.lastX=t.clientX;coinSwipe.lastY=t.clientY;}}finishCoinSwipe();},{passive:true});
    document.addEventListener('touchcancel',()=>{coinSwipe=null;},{passive:true});
    document.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'&&e.button===0)coinSwipe=beginCoinSwipe(e.target,e.pointerId,e.clientX,e.clientY);});
    document.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'&&coinSwipe?.id===e.pointerId)moveCoinSwipe(e,e.clientX,e.clientY);});
    document.addEventListener('pointerup',e=>{if(e.pointerType==='mouse'&&coinSwipe?.id===e.pointerId){moveCoinSwipe(e,e.clientX,e.clientY);finishCoinSwipe();}});
    document.addEventListener('pointercancel',e=>{if(e.pointerType==='mouse')coinSwipe=null;});
    function quickActionFeedback(button,trusted){
      if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&typeof button.animate==='function')button.animate([{transform:'scale(.965)'},{transform:'scale(1)'}],{duration:180,easing:'cubic-bezier(.2,.8,.2,1)'});
      if(trusted&&typeof navigator.vibrate==='function'){try{navigator.vibrate(12);}catch{}}
    }
    document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b){const row=e.target.closest('#market-body tr[data-coin]');if(row)navigate('detail',row.dataset.coin);return;}if(b.classList.contains('quick-action'))quickActionFeedback(b,e.isTrusted);if(b.dataset.currency){state.currency=b.dataset.currency;save();render();}else if(b.dataset.page)navigate(b.dataset.page);else if(b.dataset.coin)navigate('detail',b.dataset.coin);else if(b.dataset.card)showCard(b.dataset.card);else if(b.dataset.favorite){const id=b.dataset.favorite;state.favorites=state.favorites.includes(id)?state.favorites.filter(x=>x!==id):[...state.favorites,id];save();renderMarket();if(currentPage==='detail')renderDetail();}else if(b.dataset.chartMode)setChartMode(b.dataset.chartMode);else if(b.dataset.period){period=b.dataset.period;renderDetail();}else if(b.dataset.trade)tradeModal(b.dataset.trade);else if(b.dataset.action){switch(b.dataset.action){case 'visibility':state.hide=!state.hide;save();render();break;case 'transfer':case 'self':case 'topup':transferModal(b.dataset.action);break;case 'add-card':addCardModal();break;case 'settings':settingsModal();break;case 'profile':profileModal();break;case 'help':helpModal();break;case 'history':historyExpanded=!historyExpanded;renderAccounts();break;case 'favorites-filter':favoritesOnly=!favoritesOnly;if(currentPage==='detail')navigate('crypto');else renderMarket();break;case 'notifications':openModal('Уведомления',`<div class="notice"><strong>Добро пожаловать в Patrn</strong><p>Ваше учебное пространство готово. Все карты и монеты доступны для знакомства.</p></div><div class="notice"><strong>Данные остаются с вами</strong><p>История и балансы сохраняются в этом браузере. Управлять демоданными можно в профиле.</p></div>`);break;}}});
    $('#close-modal').onclick=closeModal;$('#modal').addEventListener('click',e=>{if(e.target===$('#modal')){const r=$('#modal').getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)closeModal();}});$('#sort-change').onclick=()=>{sortDirection=sortDirection===1?-1:1;renderMarket();};render();save();
  </script>
